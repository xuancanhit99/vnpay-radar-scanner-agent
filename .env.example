RADAR_AGENT_BASE_URL=https://radar.vnpay.dev
RADAR_AGENT_ID=windows-lab-01
RADAR_AGENT_DISPLAY_NAME=Windows Lab 01
RADAR_AGENT_SCANNER_URL=http://127.0.0.1:8000
# Optional DAST worker on the same Windows service. The engine remains bound to localhost.
RADAR_AGENT_DAST_ENABLED=false
RADAR_AGENT_DAST_AGENT_ID=windows-lab-01-dast
RADAR_AGENT_DAST_DISPLAY_NAME=Windows Lab 01 DAST
RADAR_AGENT_DAST_ENGINE_URL=http://127.0.0.1:8010
RADAR_AGENT_DAST_ENGINE_API_KEY=
# Installed services should use machine-scoped DPAPI files for both values below.
RADAR_AGENT_DAST_ENGINE_API_KEY_FILE=
RADAR_AGENT_DAST_POLL_INTERVAL_SECONDS=2
RADAR_AGENT_DAST_TIMEOUT_SECONDS=2700
RADAR_AGENT_TOKEN_URL=https://idsafe.vnpaytest.vn/realms/VNPAY-TEST/protocol/openid-connect/token
RADAR_AGENT_CLIENT_ID=vnpay-radar-agent
RADAR_AGENT_CLIENT_SECRET=
# Windows Service uses a machine-scoped DPAPI file instead of plaintext secret.
RADAR_AGENT_CLIENT_SECRET_FILE=
RADAR_AGENT_DATABASE_PATH=./agent.db
RADAR_AGENT_VERIFY_TLS=true
RADAR_AGENT_HEARTBEAT_INTERVAL_SECONDS=10
RADAR_AGENT_POLL_WAIT_SECONDS=20
RADAR_AGENT_LEASE_RENEW_INTERVAL_SECONDS=15
RADAR_AGENT_SCANNER_TIMEOUT_SECONDS=400
RADAR_AGENT_RETRY_DELAY_SECONDS=5
